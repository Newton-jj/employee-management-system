<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employees</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h1 class="mb-4">Employees</h1>

    <!-- Add Employee Form -->
    <div class="card p-4 shadow mb-5">

        <h3 class="mb-3">Add Employee</h3>

        <form action="/employees/add" method="POST" enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <input type="text"
                           name="full_name"
                           class="form-control"
                           placeholder="Full Name"
                           required>
                </div>

                <div class="col-md-6 mb-3">
                    <input type="email"
                           name="email"
                           class="form-control"
                           placeholder="Email"
                           required>
                </div>

                <div class="col-md-6 mb-3">
                    <input type="text"
                           name="phone"
                           class="form-control"
                           placeholder="Phone">
                </div>

                <div class="col-md-6 mb-3">
                    <input type="text"
                           name="department"
                           class="form-control"
                           placeholder="Department">
                </div>

                <div class="col-md-6 mb-3">
                    <input type="text"
                           name="position"
                           class="form-control"
                           placeholder="Position">
                </div>

                <div class="col-md-6 mb-3">
                    <input type="number"
                           name="salary"
                           class="form-control"
                           placeholder="Salary">
                </div>

                <div class="col-md-6 mb-3">

    <label>Profile Photo</label>

    <input type="file"
           name="photo"
           class="form-control">

</div>

            </div>

            <button class="btn btn-success">
                Add Employee
            </button>

        </form>

    </div>

    <!-- Employee Table -->
    <!-- Search Bar -->

<div class="d-flex justify-content-between mb-4">

    <h2>Employee List</h2>

    <form action="/employees/search"
          method="GET"
          class="d-flex">

        <input type="text"
               name="search"
               class="form-control me-2"
               placeholder="Search employee">

        <button class="btn btn-dark">
            Search
        </button>

    </form>

</div>

<table class="table table-hover table-bordered">

    <thead class="table-dark">

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Actions</th>
            <th>photo</th>
        </tr>

    </thead>

    <tbody>

    <% employees.forEach(employee => { %>

        <tr>

            <td><%= employee.id %></td>

            <td><%= employee.full_name %></td>

            <td><%= employee.email %></td>

            <td><%= employee.department %></td>

            <td><%= employee.position %></td>

            <td>$<%= employee.salary %></td>

            <td>

                <a href="/employees/edit/<%= employee.id %>"
                   class="btn btn-warning btn-sm">

                    Edit

                </a>

                <a href="/employees/delete/<%= employee.id %>"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Delete employee?')">

                    Delete

                </a>

            </td>
            <td>

    <% if(employee.photo){ %>

        <img src="/uploads/<%= employee.photo %>"
             width="50"
             height="50"
             style="object-fit:cover;
                    border-radius:50%;">

    <% } else { %>

        No Photo

    <% } %>

</td>

        </tr>

    <% }) %>

    </tbody>

</table>

</body>
</html>